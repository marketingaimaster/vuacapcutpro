rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Connection testing collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Affiliates collection
    match /affiliates/{userId} {
      // Anyone can read affiliate profile for referral verification and admin stats
      allow read: if true;
      
      // Affiliate registration & creation
      allow create: if true;
      
      // Update profile, referral tracking clicks, balance increments, and commission rates
      allow update: if true;
      
      allow delete: if isAuthenticated();
    }

    // Affiliate orders collection
    match /affiliate_orders/{orderId} {
      // Allow read so that affiliate dashboard and admin portal can view orders
      allow read: if true;
      
      // Allow customers to record referral orders
      allow create: if true;
      
      // Allow admin / shop owner to approve/reject orders
      allow update: if true;
      allow delete: if true;
    }

    // Withdrawal requests collection
    match /withdrawal_requests/{requestId} {
      // Allow read so that affiliate history and admin portal can view payout requests
      allow read: if true;
      
      // Affiliates can submit their withdrawal request
      allow create: if true;
      
      // Admin can approve, reject or update payout status
      allow update: if true;
      allow delete: if true;
    }
  }
}
